# Copie para server/.env para rodar a API fora do Docker (npm start).
# Em produção (Render), configure estas variáveis no painel — nunca faça commit do .env real.

# Neon: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Local (docker compose up -d db): postgres://vertix:vertix123@localhost:5433/vertix_funcionarios
DATABASE_URL=postgres://vertix:vertix123@localhost:5433/vertix_funcionarios

# Segredo de assinatura do login (use um texto longo e aleatório em produção)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# URL(s) do front autorizadas a chamar a API (separe por vírgula). Vazio = libera tudo (só para dev)
CORS_ORIGIN=

# Usuário administrador criado no primeiro start (quando não existe nenhum usuário)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# "false" para não criar os funcionários de demonstração
SEED_DEMO=true

APP_TIMEZONE=America/Manaus
MAX_FILE_MB=10
PORT=5000
